# =================================================================
# ENVIRONMENT VARIABLES - AUTOABSEN SMANSS
# Salin file ini menjadi .env.local untuk pengujian lokal,
# dan masukkan variabel-variabel ini ke Vercel Project Settings.
# =================================================================

# 1. Supabase Project URL (didapat dari Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Key (Public Key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Supabase Service Role Key (Kunci Rahasia untuk akses Serverless Vercel)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
